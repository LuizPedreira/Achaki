{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "achaki",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "routes": [{ "pattern": "achaki.jrsites.online", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "achaki", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "achaki-photos" }],
  "durable_objects": { "bindings": [{ "name": "PASSWORDS", "class_name": "PasswordDerivations" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PasswordDerivations"] }],
  "vars": { "APP_ORIGIN": "https://achaki.jrsites.online", "IMAGE_SUGGESTIONS": "false" },
  "triggers": { "crons": ["17 7 * * *"] }
}
